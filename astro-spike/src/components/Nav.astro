---
/**
 * Top app bar — logo + wordmark on the left, primary nav on the right.
 * Mobile (< md) shows a hamburger that toggles the Sidebar via Alpine's
 * shared `nav` store. Desktop dropdown groups use a click/keyboard-driven
 * disclosure pattern; aria-expanded reflects state.
 */
import { primaryNav } from "../config/nav";
---

<header>
  <div
    class="fixed top-0 inset-x-0 z-50 bg-white shadow-md h-[64px] flex items-center px-5"
  >
    <!-- Mobile hamburger -->
    <button
      type="button"
      class="md:hidden inline-flex flex-col items-center justify-center min-w-[44px] min-h-[44px] rounded text-sfs-text hover:bg-neutral-100 focus-visible:outline-2 focus-visible:outline-sfs-blue focus-visible:outline-offset-2"
      x-data
      @click="$store.nav.toggle()"
      :aria-expanded="$store.nav.open ? 'true' : 'false'"
      :aria-label="$store.nav.open ? 'Close navigation menu' : 'Open navigation menu'"
      aria-controls="site-sidebar"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="28"
        height="28"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        x-show="!$store.nav.open"
      >
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="28"
        height="28"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        x-show="$store.nav.open"
        x-cloak
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
      <span
        class="text-[10px] font-black tracking-wide leading-none mt-1"
        x-text="$store.nav.open ? 'CLOSE' : 'MENU'">MENU</span
      >
    </button>

    <div class="md:hidden grow"></div>

    <!-- Logo + home link -->
    <a
      href="/"
      class="inline-flex items-center mx-4 rounded p-1 focus-visible:outline-2 focus-visible:outline-sfs-blue focus-visible:outline-offset-2"
      aria-label="Safe From the Start home"
    >
      <img
        src="/icjia-logo.png"
        alt=""
        width="55"
        height="39"
        decoding="async"
      />
    </a>

    <!-- Full title (md+) -->
    <a
      href="/"
      class="hidden sm:inline-flex items-center px-2 py-1 rounded text-sfs-text-soft hover:bg-neutral-100 focus-visible:outline-2 focus-visible:outline-sfs-blue focus-visible:outline-offset-2"
      aria-label="Safe From the Start home"
    >
      <span class="app-title font-black text-[22px] tracking-[0.004em]"
        >SAFE FROM THE START</span
      >
    </a>

    <!-- Abbreviated title (sm) -->
    <a
      href="/"
      class="inline-flex sm:hidden items-center px-2 py-1 rounded text-sfs-text-soft focus-visible:outline-2 focus-visible:outline-sfs-blue focus-visible:outline-offset-2"
      aria-label="SFS – Safe From the Start home"
    >
      <span class="app-title font-black text-[24px] tracking-[0.004em]">
        <abbr title="Safe From the Start" class="no-underline border-b-0"
          >SFS</abbr
        >
      </span>
    </a>

    <div class="grow"></div>

    <!-- Desktop primary nav -->
    <nav aria-label="Primary" class="hidden lg:flex items-center gap-1">
      {
        primaryNav.map((item, index) =>
          item.children ? (
            <div
              class="relative"
              x-data={`{ open: false }`}
              @keydown.escape="open = false"
              @click.outside="open = false"
            >
              <button
                type="button"
                class="inline-flex items-center gap-1 px-3 py-2 text-[18px] font-black text-sfs-text-soft rounded hover:bg-neutral-100 focus-visible:outline-2 focus-visible:outline-sfs-blue focus-visible:outline-offset-2"
                :aria-expanded="open ? 'true' : 'false'"
                aria-controls={`primary-menu-${index}`}
                @click="open = !open"
              >
                {item.main}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M7 10l5 5 5-5z" />
                </svg>
              </button>
              <ul
                id={`primary-menu-${index}`}
                class="absolute right-0 top-full mt-1 min-w-[200px] bg-white border border-neutral-200 rounded shadow-lg py-1 z-[60]"
                role="menu"
                x-show="open"
                x-cloak
                x-transition.opacity.duration.150ms
              >
                {item.children.map((child) => (
                  <li role="none">
                    <a
                      href={child.link}
                      class="block px-4 py-2 text-[14px] font-bold text-sfs-text-soft hover:bg-neutral-100 focus-visible:bg-neutral-100 focus-visible:outline-none"
                      role="menuitem"
                    >
                      {child.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ) : (
            <a
              href={item.link}
              class="px-3 py-2 text-[18px] font-black text-sfs-text-soft rounded hover:bg-neutral-100 focus-visible:outline-2 focus-visible:outline-sfs-blue focus-visible:outline-offset-2"
              data-nav-link
              data-href={item.link}
            >
              {item.main}
            </a>
          )
        )
      }
    </nav>
  </div>
</header>

<script>
  // Underline the link matching the current path.
  const path = window.location.pathname.replace(/\/$/, "") || "/";
  document.querySelectorAll<HTMLElement>("[data-nav-link]").forEach((el) => {
    const href = (el.dataset.href || "").replace(/\/$/, "") || "/";
    if (href === path) {
      el.classList.add("underline", "decoration-2", "underline-offset-4");
      el.setAttribute("aria-current", "page");
    }
  });
</script>
