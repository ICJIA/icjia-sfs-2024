---
/**
 * Navigation drawer for viewports below lg (1280px) — the same range that
 * shows the hamburger. Native nav/ul/li so ARIA roles fall out for free;
 * a plain disclosure, not a dialog (no focus trap to fake). Server-rendered
 * closed: slid offscreen AND inert + aria-hidden, so its links stay out of
 * the tab order and the accessibility tree until opened. The interactions
 * script in Layout.astro toggles state, moves focus to the first link on
 * open, and restores focus to the hamburger on close.
 */
import { sidebarNav } from "../config/nav";
---

<div
  id="site-sidebar"
  class="lg:hidden fixed top-0 left-0 h-full w-[280px] max-w-[80vw] bg-white shadow-2xl z-[60] transform -translate-x-full transition-transform duration-200"
  inert
  aria-hidden="true"
>
  <nav aria-label="Main navigation" class="py-2">
    <ul class="m-0 p-0 list-none">
      <li>
        <a
          href="/"
          class="flex items-center justify-between w-full px-4 py-3 text-[16px] font-black text-sfs-text hover:bg-neutral-100 focus-visible:bg-neutral-100 focus-visible:outline-none no-underline"
        >
          Home
        </a>
      </li>
      {
        sidebarNav.map((item, index) =>
          item.children ? (
            <li class="border-t border-neutral-100">
              <button
                type="button"
                class="flex items-center justify-between w-full text-left px-4 py-3 text-[16px] font-black text-sfs-text bg-transparent border-0 cursor-pointer hover:bg-neutral-100 focus-visible:bg-neutral-100 focus-visible:outline-none"
                data-acc-toggle
                aria-expanded="true"
                aria-controls={`sb-group-${index}`}
              >
                <span>{item.main}</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="transition-transform"
                  aria-hidden="true"
                >
                  <path d="M7 10l5 5 5-5z" />
                </svg>
              </button>
              <ul id={`sb-group-${index}`} class="m-0 p-0 list-none">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.link}
                      class="block px-8 py-3 text-[16px] font-normal text-sfs-text-soft no-underline hover:bg-neutral-100 focus-visible:bg-neutral-100 focus-visible:outline-none"
                    >
                      {child.title}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li class="border-t border-neutral-100">
              <a
                href={item.link}
                class="flex items-center justify-between w-full px-4 py-3 text-[16px] font-black text-sfs-text no-underline hover:bg-neutral-100 focus-visible:bg-neutral-100 focus-visible:outline-none"
              >
                {item.main}
              </a>
            </li>
          )
        )
      }
    </ul>
  </nav>
</div>

<!-- Scrim — only ever rendered below lg so it can't dim desktop. -->
<div
  class="lg:hidden fixed inset-0 bg-black/40 z-[55]"
  data-nav-scrim
  hidden
  aria-hidden="true"
>
</div>
