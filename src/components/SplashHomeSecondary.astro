---
/**
 * Decorative secondary image strip between the Core Components and the
 * Childhood Exposure section. Below-the-fold, so loading="lazy".
 */
import { Image } from "astro:assets";
import secondaryImg from "../assets/splash-28-large.jpg";

interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<div class={className}>
  <div
    class="relative w-full h-[650px] bg-neutral-200 overflow-hidden border-t border-neutral-400 border-b border-neutral-700 -mt-16"
    style="filter: grayscale(10%);"
  >
    <Image
      src={secondaryImg}
      alt=""
      role="presentation"
      widths={[640, 960, 1280, 1600]}
      sizes="100vw"
      format="webp"
      quality={50}
      loading="lazy"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover"
    />
  </div>
</div>
