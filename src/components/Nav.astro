---
/**
 * Top app bar — logo + wordmark on the left, primary nav on the right.
 * Below lg (1280px) a hamburger toggles the Sidebar drawer; at lg and up
 * the primary nav links render inline. The two ranges meet exactly at lg
 * so no viewport width is left without navigation. Behavior is wired up
 * by the vanilla interactions script in Layout.astro via data-* hooks.
 * Dropdown groups use a click/keyboard disclosure pattern; aria-expanded
 * reflects state.
 */
import { Image } from "astro:assets";
import icjiaLogo from "../assets/icjia-logo.png";
import { primaryNav } from "../config/nav";
---

<header>
  <div
    class="fixed top-0 inset-x-0 z-50 bg-white shadow-md h-[64px] flex items-center px-5"
  >
    <!-- Hamburger — shown below lg (1280px), where the inline primary nav
         takes over. (md:hidden here once orphaned 960–1279px with no nav
         controls at all.) -->
    <button
      type="button"
      class="lg:hidden inline-flex flex-col items-center justify-center min-w-[44px] min-h-[44px] rounded text-sfs-text hover:bg-neutral-100 focus-visible:outline-2 focus-visible:outline-sfs-blue focus-visible:outline-offset-2"
      data-nav-toggle
      aria-expanded="false"
      aria-label="Open navigation menu"
      aria-controls="site-sidebar"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="28"
        height="28"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="28"
        height="28"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        hidden
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
      <span
        class="text-[0.625rem] font-black tracking-wide leading-none mt-1"
        data-nav-toggle-label>MENU</span
      >
    </button>

    <div class="lg:hidden grow"></div>

    <!-- Logo + home link -->
    <a
      href="/"
      class="inline-flex items-center mx-4 rounded p-1 focus-visible:outline-2 focus-visible:outline-sfs-blue focus-visible:outline-offset-2"
      aria-label="Safe From the Start home"
    >
      <Image
        src={icjiaLogo}
        alt=""
        width={55}
        height={39}
        widths={[55, 110, 165]}
        sizes="55px"
        format="webp"
        quality={85}
        loading="eager"
        decoding="async"
      />
    </a>

    <!-- Full title (>= sm, matches Vuetify hidden-sm-and-down -> >=600px) -->
    <a
      href="/"
      class="hidden sm:inline-flex items-center px-2 py-1 rounded text-sfs-text-soft hover:bg-neutral-100 focus-visible:outline-2 focus-visible:outline-sfs-blue focus-visible:outline-offset-2"
      aria-label="Safe From the Start home"
    >
      <span class="app-title font-black text-[1.375rem] tracking-[0.004em]"
        >SAFE FROM THE START</span
      >
    </a>

    <!-- Abbreviated title (< sm, matches Vuetify hidden-md-and-up -> <960px;
         we approximate with <sm=600 to avoid overlap with the full title) -->
    <a
      href="/"
      class="inline-flex sm:hidden items-center px-2 py-1 rounded text-sfs-text-soft focus-visible:outline-2 focus-visible:outline-sfs-blue focus-visible:outline-offset-2"
      aria-label="SFS – Safe From the Start home"
    >
      <span class="app-title font-black text-[1.5rem] tracking-[0.004em]">
        <abbr title="Safe From the Start" class="no-underline border-b-0"
          >SFS</abbr
        >
      </span>
    </a>

    <div class="grow"></div>

    <!-- Search icon (visible at all breakpoints; sits to the right of
         the title on mobile, left of the primary nav on desktop). -->
    <a
      href="/search"
      aria-label="Search"
      class="inline-flex items-center justify-center w-11 h-11 rounded text-sfs-text-soft hover:bg-neutral-100 focus-visible:outline-2 focus-visible:outline-sfs-blue focus-visible:outline-offset-2"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <line x1="20" y1="20" x2="16.65" y2="16.65"></line>
      </svg>
    </a>

    <!-- Desktop primary nav (>= lg = 1280px, matches Vuetify
         hidden-md-and-down). Dropdowns are plain disclosure lists —
         deliberately NOT role="menu"/"menuitem", which would promise
         APG arrow-key behavior these simple link lists don't need. -->
    <nav aria-label="Primary" class="hidden lg:flex items-center gap-1">
      {
        primaryNav.map((item, index) =>
          item.children ? (
            <div class="relative" data-dropdown>
              <button
                type="button"
                class="inline-flex items-center gap-1 px-3 py-2 text-[1.125rem] font-black text-sfs-text-soft rounded hover:bg-neutral-100 focus-visible:outline-2 focus-visible:outline-sfs-blue focus-visible:outline-offset-2"
                aria-expanded="false"
                aria-controls={`primary-menu-${index}`}
              >
                {item.main}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M7 10l5 5 5-5z" />
                </svg>
              </button>
              <ul
                id={`primary-menu-${index}`}
                class="absolute right-0 top-full mt-1 min-w-[200px] bg-white border border-neutral-200 rounded shadow-lg py-1 z-[60]"
                hidden
              >
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.link}
                      class="block px-4 py-2 text-[0.875rem] font-bold text-sfs-text-soft hover:bg-neutral-100 focus-visible:bg-neutral-100 focus-visible:outline-2 focus-visible:outline-sfs-blue focus-visible:[outline-offset:-2px]"
                    >
                      {child.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ) : (
            <a
              href={item.link}
              class="px-3 py-2 text-[1.125rem] font-black text-sfs-text-soft rounded hover:bg-neutral-100 focus-visible:outline-2 focus-visible:outline-sfs-blue focus-visible:outline-offset-2"
              data-nav-link
              data-href={item.link}
            >
              {item.main}
            </a>
          )
        )
      }
    </nav>
  </div>
</header>

<script>
  // Underline the link matching the current path.
  const path = window.location.pathname.replace(/\/$/, "") || "/";
  document.querySelectorAll<HTMLElement>("[data-nav-link]").forEach((el) => {
    const href = (el.dataset.href || "").replace(/\/$/, "") || "/";
    if (href === path) {
      el.classList.add("underline", "decoration-2", "underline-offset-4");
      el.setAttribute("aria-current", "page");
    }
  });
</script>
