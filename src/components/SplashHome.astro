---
/**
 * Hero block: full-bleed image with a navy headline card and Learn More CTA.
 * The LCP image is rendered via Astro <Image>; Sharp emits a WebP srcset at
 * build time and the browser picks the smallest variant for mobile via
 * sizes="100vw". loading="eager" + fetchpriority="high" lets the browser
 * preloader prioritize it without needing a manual <link rel="preload">.
 */
import { Image } from "astro:assets";
import heroImg from "../assets/splash-24-large-cropped.jpg";
---

<section>
  <div class="relative">
    <!-- Hero image. Decorative; alt empty + role="presentation". -->
    <div
      class="relative w-full h-[700px] bg-neutral-200 overflow-hidden"
      style="filter: grayscale(10%);"
    >
      <Image
        src={heroImg}
        alt=""
        role="presentation"
        widths={[480, 768, 1024, 1200, 1600]}
        sizes="100vw"
        format="webp"
        quality={45}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover"
      />
      <!-- Match the original v-img gradient overlay. -->
      <div
        class="absolute inset-0 pointer-events-none"
        style="background: linear-gradient(to bottom, rgba(0,0,0,0.3), rgba(0,0,0,0.1));"
        aria-hidden="true"
      >
      </div>
    </div>

    <!-- Overlay headline + CTA. -->
    <div
      class="absolute left-0 right-0 bottom-[25%] w-full text-center px-6"
    >
      <h1
        class="inline-block bg-sfs-navy-deep text-white font-bold leading-[1.15] px-[0.8em] py-[0.4em] rounded-md max-w-[22ch] mx-auto text-[2rem] md:text-[2.875rem]"
        style="text-shadow: 2px 2px 8px rgba(0,0,0,1), 1px 1px 4px rgba(0,0,0,0.9);"
      >
        Direct services to children who have been exposed to violence
      </h1>

      <div class="mt-6">
        <a href="/about" class="sfs-btn sfs-btn--filled">
          Learn More&nbsp;&raquo;
        </a>
      </div>
    </div>
  </div>
</section>
