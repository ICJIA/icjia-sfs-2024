---
/**
 * Two-tier footer: context strip with footer nav, then ICJIA branding + socials.
 * Matches the Nuxt site's color tokens (#1263a5 / #0d4474) and link semantics.
 */
import { Image } from "astro:assets";
import icjiaLogo from "../assets/icjia-logo.png";
import { footerNav } from "../config/nav";
// Build-time fallback; the Layout script refreshes it client-side so the
// copyright doesn't go stale across a year boundary between deploys.
const year = new Date().getFullYear();
---

<footer>
  <nav
    aria-label="Footer navigation"
    class="bg-sfs-blue py-3 px-2"
    style="font-family: var(--font-context);"
  >
    <ul
      class="m-0 p-0 list-none flex flex-wrap items-center justify-center gap-y-1 gap-x-3"
    >
      {
        footerNav.map((item, index) => (
          <li class="inline-flex items-center">
            <a
              href={item.link}
              class="px-2 py-1 text-white text-[13px] font-bold uppercase tracking-[0.09em] rounded-sm no-underline hover:underline focus-visible:underline focus-visible:outline-2 focus-visible:outline-white focus-visible:outline-offset-2"
            >
              {item.main}
            </a>
            {index !== footerNav.length - 1 && (
              <span class="text-white ml-3" aria-hidden="true">
                |
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </nav>

  <section class="bg-sfs-navy text-center text-white pb-4">
    <div class="max-w-screen-xl mx-auto px-4 py-8">
      <a
        href="https://icjia.illinois.gov"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Illinois Criminal Justice Information Authority (opens in new window)"
        class="inline-block leading-none focus-visible:outline-3 focus-visible:outline-white focus-visible:outline-offset-4"
      >
        <Image
          src={icjiaLogo}
          alt=""
          width={150}
          height={105}
          widths={[150, 300, 450]}
          sizes="150px"
          format="webp"
          quality={85}
          loading="lazy"
          decoding="async"
          class="inline"
        />
      </a>

      <nav aria-label="Social media" class="-mt-2 pb-6 flex justify-center gap-3">
        {[
          {
            href: "https://www.facebook.com/ICJIA/",
            label: "ICJIA on Facebook (opens in new window)",
            d: "M22 12.07C22 6.51 17.52 2 12 2S2 6.51 2 12.07c0 5 3.66 9.13 8.44 9.93v-7.02H7.9v-2.9h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.19 2.24.19v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.87h2.78l-.45 2.9h-2.33V22c4.78-.8 8.44-4.94 8.44-9.93z",
          },
          {
            href: "https://www.youtube.com/c/illinoiscriminaljusticeinformationauthority",
            label: "ICJIA on YouTube (opens in new window)",
            d: "M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31.5 31.5 0 0 0 0 12a31.5 31.5 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1 31.5 31.5 0 0 0 .5-5.8 31.5 31.5 0 0 0-.5-5.8zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z",
          },
          {
            href: "https://www.instagram.com/icjia_illinois/",
            label: "ICJIA on Instagram (opens in new window)",
            d: "M12 2.2c3.2 0 3.6 0 4.8.1 1.2 0 1.9.2 2.3.4.6.2 1 .5 1.5 1s.8.9 1 1.5c.2.4.4 1.1.4 2.3.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c0 1.2-.2 1.9-.4 2.3-.2.6-.5 1-1 1.5s-.9.8-1.5 1c-.4.2-1.1.4-2.3.4-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2 0-1.9-.2-2.3-.4-.6-.2-1-.5-1.5-1s-.8-.9-1-1.5c-.2-.4-.4-1.1-.4-2.3C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8c0-1.2.2-1.9.4-2.3.2-.6.5-1 1-1.5s.9-.8 1.5-1c.4-.2 1.1-.4 2.3-.4C8.4 2.2 8.8 2.2 12 2.2zm0 1.8c-3.2 0-3.5 0-4.7.1-1.1.1-1.7.2-2.1.4-.5.2-.9.4-1.3.8s-.6.8-.8 1.3c-.2.4-.3 1-.4 2.1-.1 1.2-.1 1.5-.1 4.7s0 3.5.1 4.7c.1 1.1.2 1.7.4 2.1.2.5.4.9.8 1.3s.8.6 1.3.8c.4.2 1 .3 2.1.4 1.2.1 1.5.1 4.7.1s3.5 0 4.7-.1c1.1-.1 1.7-.2 2.1-.4.5-.2.9-.4 1.3-.8s.6-.8.8-1.3c.2-.4.3-1 .4-2.1.1-1.2.1-1.5.1-4.7s0-3.5-.1-4.7c-.1-1.1-.2-1.7-.4-2.1-.2-.5-.4-.9-.8-1.3s-.8-.6-1.3-.8c-.4-.2-1-.3-2.1-.4-1.2-.1-1.5-.1-4.7-.1zm0 3.1a4.9 4.9 0 1 1 0 9.8 4.9 4.9 0 0 1 0-9.8zm0 8.1a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4zm6.3-8.3a1.15 1.15 0 1 1-2.3 0 1.15 1.15 0 0 1 2.3 0z",
          },
          {
            href: "https://www.linkedin.com/company/icjia/",
            label: "ICJIA on LinkedIn (opens in new window)",
            d: "M20.45 20.45h-3.55v-5.56c0-1.33 0-3.04-1.85-3.04s-2.14 1.45-2.14 2.94v5.66H9.36V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .78 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .78 23.2 0 22.22 0z",
          },
        ].map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.label}
            class="inline-flex items-center justify-center w-10 h-10 text-white rounded no-underline hover:underline focus-visible:outline-2 focus-visible:outline-white focus-visible:outline-offset-2"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d={s.d} />
            </svg>
          </a>
        ))
      }
      </nav>

      <div class="text-[12px] font-normal">
        <strong>
          &copy; <span data-footer-year>{year}</span>
          <a
            href="https://icjia.illinois.gov"
            target="_blank"
            rel="noopener noreferrer"
            class="text-white underline-offset-2"
            >Illinois Criminal Justice Information Authority<span class="sr-only"
            >
              (opens in new window)</span
          ></a
          >
        </strong>
        &nbsp;|&nbsp;
        <strong><a href="/privacy" class="text-white">Privacy</a></strong>
      </div>
    </div>
  </section>
</footer>
