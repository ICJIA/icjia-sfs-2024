---
/**
 * /sites — markdown body from content/sites.md (which contains the table
 * styles and the agency table itself) plus the client scripts that keep the
 * table's scroll container keyboard-reachable and decorate agency links with
 * hover tooltips. Mirrors app/pages/sites/index.vue.
 */
import { getEntry, render } from "astro:content";
import MarkdownPage from "../layouts/MarkdownPage.astro";

const page = await getEntry("pages", "sites");
if (!page) throw new Error("sites.md not found");
const { Content } = await render(page);
---

<MarkdownPage
  title={page.data.title}
  metaTitle={page.data.metaTitle}
  description={page.data.summary ??
    "Directory of Safe From the Start program sites across Illinois."}
  publishedAt={page.data.publishedAt}
>
  <Content />
</MarkdownPage>

<script>
  /*
   * A container that scrolls horizontally has to be reachable by keyboard
   * (WCAG 2.1.1) — otherwise the clipped columns are unreachable without a
   * mouse. But the sites table only overflows at wider viewports: below
   * 768px it reflows into stacked cards and there is nothing to scroll, so a
   * permanent tabindex would leave an empty tab stop on phones. Toggle it to
   * match the element's actual state.
   */
  const scrollers =
    document.querySelectorAll<HTMLElement>(".sfs-sites-wrap");

  const syncScrollability = (el: HTMLElement) => {
    // 1px of slack absorbs sub-pixel layout rounding.
    const overflows = el.scrollWidth - el.clientWidth > 1;
    if (overflows) {
      el.setAttribute("tabindex", "0");
      el.setAttribute("role", "region");
      el.setAttribute("aria-label", "Safe From the Start program sites, scrollable table");
    } else {
      el.removeAttribute("tabindex");
      el.removeAttribute("role");
      el.removeAttribute("aria-label");
    }
  };

  if (scrollers.length) {
    scrollers.forEach(syncScrollability);
    if ("ResizeObserver" in window) {
      /*
       * Observe the table as well as its container. A ResizeObserver on the
       * container alone reports only the container's own box, which does not
       * change when the *content* grows past it — so a late-loading webfont
       * widening the table would go unnoticed. Both targets map back to the
       * container that has to carry the tabindex.
       */
      const ro = new ResizeObserver((entries) => {
        const seen = new Set<HTMLElement>();
        for (const entry of entries) {
          const wrap = (entry.target as HTMLElement).closest<HTMLElement>(
            ".sfs-sites-wrap"
          );
          if (wrap && !seen.has(wrap)) {
            seen.add(wrap);
            syncScrollability(wrap);
          }
        }
      });
      scrollers.forEach((el) => {
        ro.observe(el);
        const table = el.querySelector("table");
        if (table) ro.observe(table);
      });
    } else {
      window.addEventListener("resize", () =>
        scrollers.forEach(syncScrollability)
      );
    }
  }

  /*
   * Tooltip-on-hover for agency links in the responsive table — surfaces the
   * destination URL without changing layout. Uses fixed positioning relative
   * to the cursored link so the tooltip can escape table overflow.
   */
  const agencyLinks = document.querySelectorAll<HTMLAnchorElement>(
    '.markdown-body .sfs-sites-wrap a[target="_blank"][rel="noopener noreferrer"]'
  );
  agencyLinks.forEach((link) => {
    const href = link.getAttribute("href");
    if (!href) return;
    if (link.hasAttribute("data-tooltip-added")) return;
    link.setAttribute("data-tooltip", href);
    link.classList.add("agency-link-tooltip");
    link.addEventListener("mouseenter", (e) => {
      const t = e.currentTarget as HTMLElement;
      const rect = t.getBoundingClientRect();
      t.style.setProperty("--tooltip-top", `${rect.top - 10}px`);
      t.style.setProperty(
        "--tooltip-left",
        `${rect.left + rect.width / 2}px`
      );
    });
    link.setAttribute("data-tooltip-added", "true");
  });
</script>

<style is:global>
  /*
   * Mirrors the tooltip CSS that lives in app/pages/sites/index.vue. Using
   * `is:global` because the agency links live inside ContentRenderer'd
   * markdown, which is out of any scoped style's reach.
   */
  /* Layout for .sfs-sites-wrap itself lives with the rest of the table CSS
     in content/pages/sites.md; only the tooltip belongs here. */
  .agency-link-tooltip {
    position: relative;
    cursor: pointer;
  }
  .agency-link-tooltip::before {
    content: attr(data-tooltip);
    position: fixed;
    top: var(--tooltip-top, auto);
    left: var(--tooltip-left, 50%);
    transform: translateX(-50%) translateY(-100%);
    background-color: rgba(0, 0, 0, 0.9);
    color: white;
    padding: 8px 12px;
    border-radius: 4px;
    font-size: 0.875rem;
    font-weight: normal;
    white-space: normal;
    text-align: center;
    text-decoration: none;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s,
      visibility 0.3s;
    z-index: 99999;
    pointer-events: none;
    max-width: 300px;
    word-wrap: break-word;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }
  .agency-link-tooltip::after {
    content: "";
    position: fixed;
    top: var(--tooltip-top, auto);
    left: var(--tooltip-left, 50%);
    transform: translateX(-50%) translateY(-100%) translateY(-5px);
    border: 5px solid transparent;
    border-top-color: rgba(0, 0, 0, 0.9);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s,
      visibility 0.3s;
    z-index: 99999;
  }
  .agency-link-tooltip:hover::before,
  .agency-link-tooltip:hover::after,
  .agency-link-tooltip:active::before,
  .agency-link-tooltip:active::after {
    opacity: 1;
    visibility: visible;
  }
  @media (max-width: 768px) {
    .agency-link-tooltip::before {
      font-size: 0.75rem;
      padding: 6px 10px;
      max-width: 250px;
    }
  }
  @media (max-width: 480px) {
    .agency-link-tooltip::before {
      font-size: 0.6875rem;
      padding: 5px 8px;
      max-width: 200px;
      left: 0;
      transform: none;
    }
    .agency-link-tooltip::after {
      left: 20px;
      transform: none;
    }
  }
</style>
