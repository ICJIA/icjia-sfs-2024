---
/**
 * /sites — markdown body from content/sites.md (which contains the table
 * styles and the agency table itself) plus the client script that keeps the
 * table's scroll container keyboard-reachable. Mirrors app/pages/sites/index.vue.
 *
 * The agency links used to show their URL in a hover-only CSS tooltip. It
 * failed WCAG 1.4.13 (vanished when the pointer moved onto it, ignored
 * Escape, covered neighbouring rows, never appeared on keyboard focus) and
 * added nothing the link text and the browser's status bar don't already
 * show, so it was removed in 2.1.1 rather than rebuilt.
 */
import { getEntry, render } from "astro:content";
import MarkdownPage from "../layouts/MarkdownPage.astro";

const page = await getEntry("pages", "sites");
if (!page) throw new Error("sites.md not found");
const { Content } = await render(page);
---

<MarkdownPage
  title={page.data.title}
  metaTitle={page.data.metaTitle}
  description={page.data.summary ??
    "Directory of Safe From the Start program sites across Illinois."}
  publishedAt={page.data.publishedAt}
>
  <Content />
</MarkdownPage>

<script>
  /*
   * A container that scrolls horizontally has to be reachable by keyboard
   * (WCAG 2.1.1) — otherwise the clipped columns are unreachable without a
   * mouse. But the sites table only overflows at wider viewports: below
   * 768px it reflows into stacked cards and there is nothing to scroll, so a
   * permanent tabindex would leave an empty tab stop on phones. Toggle it to
   * match the element's actual state.
   */
  const scrollers =
    document.querySelectorAll<HTMLElement>(".sfs-sites-wrap");

  const syncScrollability = (el: HTMLElement) => {
    // 1px of slack absorbs sub-pixel layout rounding.
    const overflows = el.scrollWidth - el.clientWidth > 1;
    if (overflows) {
      el.setAttribute("tabindex", "0");
      el.setAttribute("role", "region");
      el.setAttribute("aria-label", "Safe From the Start program sites, scrollable table");
    } else {
      el.removeAttribute("tabindex");
      el.removeAttribute("role");
      el.removeAttribute("aria-label");
    }
  };

  if (scrollers.length) {
    scrollers.forEach(syncScrollability);
    if ("ResizeObserver" in window) {
      /*
       * Observe the table as well as its container. A ResizeObserver on the
       * container alone reports only the container's own box, which does not
       * change when the *content* grows past it — so a late-loading webfont
       * widening the table would go unnoticed. Both targets map back to the
       * container that has to carry the tabindex.
       */
      const ro = new ResizeObserver((entries) => {
        const seen = new Set<HTMLElement>();
        for (const entry of entries) {
          const wrap = (entry.target as HTMLElement).closest<HTMLElement>(
            ".sfs-sites-wrap"
          );
          if (wrap && !seen.has(wrap)) {
            seen.add(wrap);
            syncScrollability(wrap);
          }
        }
      });
      scrollers.forEach((el) => {
        ro.observe(el);
        const table = el.querySelector("table");
        if (table) ro.observe(table);
      });
    } else {
      window.addEventListener("resize", () =>
        scrollers.forEach(syncScrollability)
      );
    }
  }
</script>

