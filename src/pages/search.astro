---
/**
 * /search — Fuse.js client island. Reads ?q= from the URL on load,
 * fetches /search-index.json once, runs Fuse, renders the results. The
 * /404 page hands queries off to this route via a GET form.
 *
 * The index lives in a separate file (src/pages/search-index.json.ts)
 * so the page HTML stays small and the index is cached independently.
 */
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Search"
  description="Search the Safe From the Start site."
  noindex={true}
>
  <div class="max-w-screen-md mx-auto px-4 pt-10 pb-20 min-h-[60vh]">
    <h1
      class="text-[2.5rem] mt-10 uppercase font-bold text-center"
      style="letter-spacing: 0.01em;"
    >
      Search
    </h1>

    <form
      role="search"
      action="/search"
      method="get"
      class="mt-8 flex flex-col sm:flex-row gap-2"
      data-search-form
    >
      <label for="sfs-search-q" class="sr-only">Search Safe From the Start</label>
      <input
        id="sfs-search-q"
        name="q"
        type="search"
        autocomplete="off"
        placeholder="Search the site…"
        class="flex-1 h-12 px-4 rounded border border-neutral-300 bg-white text-sfs-text text-[1rem] focus-visible:outline-2 focus-visible:outline-sfs-blue focus-visible:outline-offset-2"
        data-search-input
      />
      <button
        type="submit"
        class="h-12 px-6 rounded bg-sfs-navy text-white font-bold uppercase tracking-wide hover:bg-sfs-blue focus-visible:outline-2 focus-visible:outline-sfs-blue focus-visible:outline-offset-2"
      >
        Search
      </button>
    </form>

    <p
      class="mt-6 text-[0.9375rem] text-sfs-text-soft"
      data-search-status
      aria-live="polite"
    >
      Enter a search term above.
    </p>
  </div>
</Layout>

<script>
  import Fuse from "fuse.js";

  type Doc = { title: string; url: string; summary: string; body: string };

  const form = document.querySelector<HTMLFormElement>("[data-search-form]");
  const input = document.querySelector<HTMLInputElement>("[data-search-input]");
  const status = document.querySelector<HTMLElement>("[data-search-status]");
  // The results <ul> is created on demand (see ensureResultsList) and removed
  // when empty, so the static page never ships an empty container element
  // (SiteImprove sia-r68 "Container element is empty").
  let resultsEl: HTMLUListElement | null = null;

  if (!form || !input || !status) {
    // Defensive: the template guarantees these exist, but bail rather than
    // throw if a future refactor drops one.
    console.warn("[search] missing required DOM nodes");
  } else {
    let fuse: Fuse<Doc> | null = null;
    let loading: Promise<Fuse<Doc>> | null = null;

    function snippet(body: string, query: string, len = 160): string {
      if (!body) return "";
      const lower = body.toLowerCase();
      const idx = lower.indexOf(query.toLowerCase());
      if (idx < 0) return body.slice(0, len) + (body.length > len ? "…" : "");
      const start = Math.max(0, idx - 40);
      const end = Math.min(body.length, start + len);
      const prefix = start > 0 ? "…" : "";
      const suffix = end < body.length ? "…" : "";
      return prefix + body.slice(start, end) + suffix;
    }

    async function loadIndex(): Promise<Fuse<Doc>> {
      if (fuse) return fuse;
      if (loading) return loading;
      loading = (async () => {
        const res = await fetch("/search-index.json");
        if (!res.ok) throw new Error("search-index.json " + res.status);
        const docs = (await res.json()) as Doc[];
        fuse = new Fuse(docs, {
          keys: [
            { name: "title", weight: 3 },
            { name: "summary", weight: 2 },
            { name: "body", weight: 1 },
          ],
          includeScore: true,
          threshold: 0.35,
          ignoreLocation: true,
          minMatchCharLength: 2,
        });
        return fuse;
      })();
      return loading;
    }

    function ensureResultsList(): HTMLUListElement {
      if (!resultsEl) {
        resultsEl = document.createElement("ul");
        resultsEl.className = "mt-6 space-y-5 list-none p-0";
        resultsEl.setAttribute("aria-label", "Search results");
        status!.insertAdjacentElement("afterend", resultsEl);
      }
      return resultsEl;
    }

    function clearResults(): void {
      if (resultsEl) {
        resultsEl.remove();
        resultsEl = null;
      }
    }

    function renderResult(item: Doc, query: string): HTMLLIElement {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = item.url;
      a.className =
        "block p-4 rounded border border-neutral-200 hover:border-sfs-blue hover:bg-neutral-50 focus-visible:outline-2 focus-visible:outline-sfs-blue focus-visible:outline-offset-2";

      const h2 = document.createElement("h2");
      h2.className = "text-[1.25rem] font-bold text-sfs-blue-dark m-0";
      h2.textContent = item.title;
      a.appendChild(h2);

      if (item.summary) {
        const pSummary = document.createElement("p");
        pSummary.className = "mt-1 text-[0.875rem] text-sfs-text-soft m-0";
        pSummary.textContent = item.summary;
        a.appendChild(pSummary);
      }

      const snippetText = snippet(item.body, query);
      if (snippetText) {
        const pSnippet = document.createElement("p");
        pSnippet.className = "mt-2 text-[0.9375rem] text-sfs-text m-0";
        pSnippet.textContent = snippetText;
        a.appendChild(pSnippet);
      }

      li.appendChild(a);
      return li;
    }

    async function runQuery(q: string): Promise<void> {
      const trimmed = q.trim();
      if (!trimmed) {
        status!.textContent = "Enter a search term above.";
        clearResults();
        return;
      }
      status!.textContent = "Searching…";
      try {
        const f = await loadIndex();
        const matches = f.search(trimmed).slice(0, 25);
        clearResults();
        if (matches.length === 0) {
          status!.textContent = `No results for “${trimmed}”.`;
          return;
        }
        status!.textContent = `${matches.length} result${matches.length === 1 ? "" : "s"} for “${trimmed}”.`;
        const frag = document.createDocumentFragment();
        for (const { item } of matches) {
          frag.appendChild(renderResult(item, trimmed));
        }
        ensureResultsList().appendChild(frag);
      } catch (err) {
        console.error("[search]", err);
        status!.textContent = "Search is temporarily unavailable.";
        clearResults();
      }
    }

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const q = input!.value;
      const url = new URL(window.location.href);
      if (q.trim()) {
        url.searchParams.set("q", q);
      } else {
        url.searchParams.delete("q");
      }
      history.replaceState(null, "", url.toString());
      runQuery(q);
    });

    const initialQ = new URLSearchParams(window.location.search).get("q") ?? "";
    if (initialQ) {
      input.value = initialQ;
      runQuery(initialQ);
    }
    input.focus();
  }
</script>
