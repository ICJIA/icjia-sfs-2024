---
/**
 * Site-wide layout shell. Owns the <head> (via astro-seo for OG/Twitter/
 * canonical + extend for custom <link>/<meta>), the skip-link, the nav,
 * the sidebar drawer, the main slot, and the footer. Alpine is loaded
 * with `defer` so it runs after the document is parsed but before user
 * input.
 */
import "../styles/global.css";
import { SEO } from "astro-seo";
import Nav from "../components/Nav.astro";
import Sidebar from "../components/Sidebar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Safe From the Start",
  description = "The Safe From the Start (SFS) program provides developmentally and culturally appropriate direct services to children, ages 0–5, who have witnessed or been exposed to violence and their families.",
} = Astro.props;

const fullTitle =
  title === "Safe From the Start"
    ? title
    : `${title} | Safe From the Start`;

const SITE_ORIGIN = "https://sfs.icjia.illinois.gov";
// astro.config.mjs uses format: "file" + trailingSlash: "never", so
// Astro.url.pathname is /about.html, /index.html, etc. Normalize to the
// canonical no-extension form the host actually serves: / for home,
// /about for the rest.
const rawPath = Astro.url.pathname
  .replace(/\/index\.html$/, "/")
  .replace(/\.html$/, "");
const canonical = new URL(rawPath, Astro.site ?? SITE_ORIGIN).toString();
const ogImage = `${SITE_ORIGIN}/og-image.jpg`;
---

<!doctype html>
<html lang="en" data-theme="sfs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d4474" />
    <meta name="format-detection" content="telephone=no" />

    <SEO
      title={fullTitle}
      description={description}
      canonical={canonical}
      openGraph={{
        basic: {
          title: fullTitle,
          type: "website",
          image: ogImage,
          url: canonical,
        },
        image: {
          width: 1200,
          height: 630,
          alt: "Safe From the Start — direct services for children exposed to violence",
        },
        optional: {
          description,
          siteName: "Safe From the Start",
          locale: "en_US",
        },
      }}
      twitter={{
        card: "summary_large_image",
        image: ogImage,
        imageAlt: "Safe From the Start — direct services for children exposed to violence",
      }}
      extend={{
        link: [
          { rel: "icon", type: "image/x-icon", href: "/favicon.ico" },
          { rel: "alternate", hreflang: "en", href: canonical },
          { rel: "alternate", hreflang: "x-default", href: canonical },
        ],
      }}
    />

    <!-- URL normalizer: strips a trailing slash from non-root paths so
         Plausible doesn't log /foo and /foo/ as separate pages. Inline +
         is:inline so the byte-for-byte content is stable and CSP can
         hash-allow it (see netlify.toml). Runs before the deferred
         Plausible script. -->
    <script is:inline>if(location.pathname!=="/"&&location.pathname.endsWith("/")){history.replaceState(null,"",location.pathname.slice(0,-1)+location.search+location.hash);}</script>

    <!-- Plausible (self-hosted). The .file-downloads.outbound-links.js
         variant bundles two extensions — outbound-link clicks and file
         downloads — into one ~2.5 KB request. -->
    <script
      is:inline
      defer
      data-domain="sfs.icjia.illinois.gov"
      src="https://plausible.icjia.cloud/js/script.file-downloads.outbound-links.js"
    ></script>

    <style>
      [x-cloak] {
        display: none !important;
      }
    </style>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <Nav />
    <Sidebar />

    <main id="main-content" tabindex="-1" class="min-h-[90vh] pt-[64px]">
      <slot />
    </main>

    <Footer />

    <!-- Alpine for tiny island interactivity (nav drawer + dropdowns). ~14 KB gz. -->
    <script>
      import Alpine from "alpinejs";
      // Shared store so the header hamburger and the sidebar agree on state.
      Alpine.store("nav", {
        open: false as boolean,
        toggle() {
          this.open = !this.open;
        },
        close() {
          this.open = false;
        },
      });
      // @ts-ignore -- expose for devtools/inspection
      window.Alpine = Alpine;
      Alpine.start();
    </script>
  </body>
</html>
