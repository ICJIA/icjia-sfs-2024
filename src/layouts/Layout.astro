---
/**
 * Site-wide layout shell. Owns the <head> (via astro-seo for OG/Twitter/
 * canonical + extend for custom <link>/<meta>), the skip-link, the nav,
 * the sidebar drawer, the main slot, and the footer. All header/drawer/
 * dropdown interactivity lives in the vanilla script at the bottom — no
 * framework, no eval, so the CSP carries no 'unsafe-eval'.
 */
import "../styles/global.css";
import { SEO } from "astro-seo";
import Nav from "../components/Nav.astro";
import Sidebar from "../components/Sidebar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  publishedAt?: string;
  updatedAt?: string;
}

const {
  title = "Safe From the Start",
  description = "Safe From the Start (SFS) provides developmentally and culturally appropriate direct services to children ages 0–5 exposed to violence, and their families.",
  noindex = false,
  publishedAt,
  updatedAt,
} = Astro.props;

const fullTitle =
  title === "Safe From the Start"
    ? title
    : `${title} | Safe From the Start`;

const SITE_ORIGIN = "https://sfs.icjia.illinois.gov";
// astro.config.mjs uses format: "file" + trailingSlash: "never", so
// Astro.url.pathname is /about.html, /index.html, etc. Normalize to the
// canonical no-extension form the host actually serves: / for home,
// /about for the rest.
const rawPath = Astro.url.pathname
  .replace(/\/index\.html$/, "/")
  .replace(/\.html$/, "");
const canonical = new URL(rawPath, Astro.site ?? SITE_ORIGIN).toString();
const ogImage = `${SITE_ORIGIN}/og-image.png`;

// JSON-LD WebPage schema for SEO + AI Readiness (MetaPeek-style checks
// look for this). Per v6.3 checklist §"JSON-LD WebPage + freshness dates":
//   - WebPage with name/description/url/image/inLanguage
//   - datePublished + dateModified (build time when the page doesn't
//     pass an explicit publishedAt/updatedAt)
//   - isPartOf the WebSite
//   - publisher Organization (ICJIA) with logo
// JSON-LD lives in <script type="application/ld+json"> which CSP does
// NOT enforce on (it's a data block, not executable), so no hash needed.
const buildTime = new Date().toISOString();
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: fullTitle,
  description,
  url: canonical,
  image: ogImage,
  inLanguage: "en-US",
  // Real frontmatter dates when the page provides them; build time only as
  // a last resort (home/search/404). Falling back to publishedAt for
  // dateModified beats stamping every page "modified today" on each deploy.
  datePublished: publishedAt ?? buildTime,
  dateModified: updatedAt ?? publishedAt ?? buildTime,
  isPartOf: {
    "@type": "WebSite",
    name: "Safe From the Start",
    url: `${SITE_ORIGIN}/`,
  },
  publisher: {
    "@type": "Organization",
    name: "Illinois Criminal Justice Information Authority",
    url: "https://icjia.illinois.gov",
    logo: {
      "@type": "ImageObject",
      url: `${SITE_ORIGIN}/og-image.png`,
    },
  },
};
---

<!doctype html>
<html lang="en" data-theme="sfs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d4474" />
    <meta name="format-detection" content="telephone=no" />

    <SEO
      title={fullTitle}
      description={description}
      canonical={canonical}
      noindex={noindex}
      nofollow={false}
      openGraph={{
        basic: {
          title: fullTitle,
          type: "website",
          image: ogImage,
          url: canonical,
        },
        image: {
          width: 1200,
          height: 630,
          alt: "Safe From the Start — direct services for children exposed to violence",
        },
        optional: {
          description,
          siteName: "Safe From the Start",
          locale: "en_US",
        },
      }}
      twitter={{
        card: "summary_large_image",
        image: ogImage,
        imageAlt: "Safe From the Start — direct services for children exposed to violence",
      }}
      extend={{
        link: [
          { rel: "icon", type: "image/x-icon", href: "/favicon.ico" },
          { rel: "alternate", hreflang: "en", href: canonical },
          { rel: "alternate", hreflang: "x-default", href: canonical },
        ],
        meta: [
          { name: "author", content: "Illinois Criminal Justice Information Authority" },
          ...(publishedAt
            ? [{ property: "article:published_time", content: publishedAt }]
            : []),
          ...(updatedAt
            ? [{ property: "article:modified_time", content: updatedAt }]
            : []),
        ],
      }}
    />

    <!-- JSON-LD WebPage. CSP doesn't enforce on data blocks. -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- URL normalizer: strips a trailing slash from non-root paths so
         Plausible doesn't log /foo and /foo/ as separate pages. Inline +
         is:inline so the byte-for-byte content is stable and CSP can
         hash-allow it (see netlify.toml). Runs before the deferred
         Plausible script. -->
    <script is:inline>if(location.pathname!=="/"&&location.pathname.endsWith("/")){history.replaceState(null,"",location.pathname.slice(0,-1)+location.search+location.hash);}</script>

    <!-- Plausible (self-hosted). The .file-downloads.outbound-links.js
         variant bundles two extensions — outbound-link clicks and file
         downloads — into one ~2.5 KB request. -->
    <script
      is:inline
      defer
      data-domain="sfs.icjia.illinois.gov"
      src="https://plausible.icjia.cloud/js/script.file-downloads.outbound-links.js"
    ></script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <Nav />
    <Sidebar />

    <main id="main-content" tabindex="-1" class="min-h-[90vh] pt-[64px]">
      <slot />
    </main>

    <Footer />

    <!-- Header / drawer / dropdown interactivity. Vanilla DOM so the CSP
         needs no 'unsafe-eval' (the old Alpine island evaluated x-*
         directives via new Function()). -->
    <script>
      const hamburger = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
      const drawer = document.getElementById("site-sidebar");
      const scrim = document.querySelector<HTMLElement>("[data-nav-scrim]");

      let drawerOpen = false;

      // Drawer state. Closed = slid offscreen AND inert/aria-hidden, so its
      // links leave the tab order and the accessibility tree (WCAG 2.4.3 —
      // previously the offscreen links stayed keyboard-focusable).
      function setDrawer(open: boolean) {
        if (!hamburger || !drawer || !scrim) return;
        drawerOpen = open;
        drawer.classList.toggle("translate-x-0", open);
        drawer.classList.toggle("-translate-x-full", !open);
        drawer.toggleAttribute("inert", !open);
        if (open) drawer.removeAttribute("aria-hidden");
        else drawer.setAttribute("aria-hidden", "true");
        scrim.hidden = !open;
        hamburger.setAttribute("aria-expanded", open ? "true" : "false");
        hamburger.setAttribute(
          "aria-label",
          open ? "Close navigation menu" : "Open navigation menu"
        );
        const [burgerIcon, closeIcon] = hamburger.querySelectorAll("svg");
        if (burgerIcon) burgerIcon.toggleAttribute("hidden", open);
        if (closeIcon) closeIcon.toggleAttribute("hidden", !open);
        const label = hamburger.querySelector("[data-nav-toggle-label]");
        if (label) label.textContent = open ? "CLOSE" : "MENU";
      }

      // Move focus out BEFORE the drawer goes inert/aria-hidden.
      function closeDrawer(restoreFocus: boolean) {
        if (!drawerOpen) return;
        if (restoreFocus || drawer?.contains(document.activeElement)) {
          hamburger?.focus();
        }
        setDrawer(false);
      }

      hamburger?.addEventListener("click", () => {
        if (drawerOpen) {
          closeDrawer(true);
        } else {
          setDrawer(true);
          drawer?.querySelector<HTMLElement>("a[href]")?.focus();
        }
      });
      scrim?.addEventListener("click", () => closeDrawer(false));
      drawer?.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).closest("a[href]")) setDrawer(false);
      });
      // Disclosure pattern: tabbing out of the open drawer closes it, so
      // keyboard focus never lands on content hidden behind the scrim.
      drawer?.addEventListener("focusout", (e) => {
        const next = e.relatedTarget as Node | null;
        if (drawerOpen && next && !drawer.contains(next) && next !== hamburger) {
          setDrawer(false);
        }
      });

      // Sidebar accordion groups.
      document.querySelectorAll<HTMLButtonElement>("[data-acc-toggle]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const panel = document.getElementById(btn.getAttribute("aria-controls") ?? "");
          const isOpen = btn.getAttribute("aria-expanded") === "true";
          btn.setAttribute("aria-expanded", isOpen ? "false" : "true");
          if (panel) panel.hidden = isOpen;
          btn.querySelector("svg")?.classList.toggle("-rotate-90", isOpen);
        });
      });

      // Desktop nav dropdowns (plain disclosure: button + list, no menu roles).
      const dropdowns = document.querySelectorAll<HTMLElement>("[data-dropdown]");
      function closeDropdown(dd: HTMLElement, restoreFocus = false) {
        const btn = dd.querySelector<HTMLButtonElement>("button");
        const panel = dd.querySelector<HTMLElement>("ul");
        if (!btn || !panel || panel.hidden) return;
        if (restoreFocus && dd.contains(document.activeElement)) btn.focus();
        panel.hidden = true;
        btn.setAttribute("aria-expanded", "false");
      }
      dropdowns.forEach((dd) => {
        const btn = dd.querySelector<HTMLButtonElement>("button");
        const panel = dd.querySelector<HTMLElement>("ul");
        if (!btn || !panel) return;
        btn.addEventListener("click", () => {
          const willOpen = panel.hidden;
          dropdowns.forEach((other) => closeDropdown(other));
          panel.hidden = !willOpen;
          btn.setAttribute("aria-expanded", willOpen ? "true" : "false");
        });
        dd.addEventListener("focusout", (e) => {
          const next = e.relatedTarget as Node | null;
          if (next && !dd.contains(next)) closeDropdown(dd);
        });
      });
      document.addEventListener("click", (e) => {
        const t = e.target as Node;
        dropdowns.forEach((dd) => {
          if (!dd.contains(t)) closeDropdown(dd);
        });
      });

      document.addEventListener("keydown", (e) => {
        if (e.key !== "Escape") return;
        if (drawerOpen) closeDrawer(true);
        else dropdowns.forEach((dd) => closeDropdown(dd, true));
      });

      // Keep the footer copyright honest between deploys.
      const year = document.querySelector("[data-footer-year]");
      if (year) year.textContent = String(new Date().getFullYear());
    </script>
  </body>
</html>
