{
  "$schema": "https://typedoc.org/schema.json",
  "tsconfig": "./tsconfig.json",
  "entryPoints": [
    "app/composables/states.ts",
    "app/utils/thumbor.js"
  ],
  "entryPointStrategy": "expand",
  "out": "public/docs/jsdoc",
  "name": "ICJIA Safe From the Start - API Documentation",
  "readme": "none",
  "includeVersion": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "excludeNotDocumented": false,
  "skipErrorChecking": true,
  "sort": ["source-order"],
  "sourceLinkTemplate": "https://github.com/ICJIA/icjia-sfs-2024/blob/main/{path}#L{line}",
  "validation": {
    "notExported": false,
    "invalidLink": false
  },
  "theme": "default",
  "navigationLinks": {
    "Home": "/",
    "Documentation Portal": "/docs/"
  }
}

