{
  "name": "icjia-sfs",
  "type": "module",
  "version": "2.1.2",
  "description": "ICJIA Safe From the Start — static site built with Astro 7 + Tailwind v4.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ICJIA/icjia-sfs-2024.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check:links": "node scripts/check-links.mjs",
    "check:links:internal": "node scripts/check-links.mjs --internal-only",
    "audit:lh": "node scripts/audit-lh.mjs",
    "audit:axe": "node scripts/audit-axe.mjs",
    "og-image": "node scripts/build-og-image.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "yaml@<2.8.3": ">=2.8.3"
    }
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.2",
    "@fontsource/lato": "^5.2.7",
    "@fontsource/raleway": "^5.2.8",
    "@fontsource/roboto": "^5.2.10",
    "astro": "^7.2.0",
    "astro-seo": "^1.1.0",
    "fuse.js": "^7.4.2",
    "rehype-external-links": "^3.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.0",
    "tailwindcss": "^4.3.0"
  }
}
